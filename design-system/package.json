{
  "name": "@oc/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Swiss-style design system for olegchursin.com — tokens, global styles and Lit web components.",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles.css": "./src/styles/index.css",
    "./theme-init": "./src/theme-init.ts"
  },
  "scripts": {
    "dev": "vite docs",
    "build:docs": "vite build docs --outDir ../dist-docs --emptyOutDir",
    "test": "web-test-runner",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "vite": "^8.3.4"
  }
}
