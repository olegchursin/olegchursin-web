{
  "name": "olegchursin-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "design-system",
    "site"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "dev:ds": "npm run dev -w design-system",
    "build": "npm run build -w site",
    "build:ds-docs": "npm run build:docs -w design-system",
    "preview": "npm run preview -w site",
    "test": "npm test -w design-system",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
